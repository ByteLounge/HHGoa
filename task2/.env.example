# Task 2 Environment Variables

# Sarvam AI STT Credentials
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text

# LLM Credentials & Provider Configuration (groq, openai, gemini, mock)
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Vector Index Configuration
VECTOR_INDEX_TYPE=faiss
CHUNKING_STRATEGY=semantic

# Guardrail Thresholds
MIN_SIMILARITY_THRESHOLD=0.45
MIN_CONTEXT_SCORE=0.40

# Server Port
PORT=8000
