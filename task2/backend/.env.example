# Render Backend Environment Configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=https://your-task2-site.netlify.app

# STT Provider Secrets (Server-side Only)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_STT_ENDPOINT=https://api.elevenlabs.io/v1/speech-to-text

# LLM Generation Secrets (Server-side Only)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=your_llm_api_key_here

# Supabase Integration Secrets (if applicable)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
